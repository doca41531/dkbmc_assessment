<aura:component controller="DKEDU_AssessmentPageController" 
                implements="forceCommunity:availableForAllPageTypes">
    
    <aura:attribute name="sheetId" type="String"/>
    <aura:attribute name="assessmentData" type="Object"/>
    <aura:attribute name="currentSectionIndex" type="Integer" default="0"/>
    <aura:attribute name="currentSection" type="Object"/>
    <aura:attribute name="responses" type="Map"/>
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <div class="assessment-container">
        <aura:if isTrue="{!not(empty(v.assessmentData))}">
            <!-- 현재 섹션 표시 -->
            <div class="current-section">
                <h2>{!v.currentSection.Name}</h2>
                
                <!-- 현재 섹션의 문항들 표시 -->
                <aura:iteration items="{!v.currentSection.items}" var="item" indexVar="itemIdx">
                    <div class="question-item">
                        <h3>문제 {!itemIdx + 1}</h3>
                        <p>{!item.questionContent}</p>
                        
                        <lightning:input name="{!item.Id}"
                                       label="답안을 입력하세요"
                                       value="{!v.responses[item.Id]}"
                                       onchange="{!c.handleResponse}"/>
                    </div>
                </aura:iteration>
            </div>
            
            <!-- 네비게이션 버튼 -->
            <div class="navigation-buttons">
                <lightning:button label="이전" 
                                onclick="{!c.previousSection}"
                                disabled="{!v.currentSectionIndex == 0}"/>
                
                <lightning:button label="다음" 
                                onclick="{!c.nextSection}"/>
                
                <lightning:button label="제출" 
                                onclick="{!c.submitAssessment}"
                                variant="brand"/>
            </div>
        </aura:if>
    </div>
</aura:component>